# Copy to .env and fill in for local development.
APP_NAME="ResearchPilot AI"
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/researchpilot

# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173

# Cloudflare R2 (S3-compatible object storage) for uploaded documents
# — local disk is not durable across redeploys on a Render/Railway-style
# container, so storage_service.py uses R2 instead. Automated tests
# never need real values (storage_service is always mocked — see
# backend/tests/conftest.py), but real local manual testing of
# upload/process/download DOES require all four set to a real R2
# bucket's credentials — there is no local-disk fallback anymore.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt
MAX_UPLOAD_SIZE_MB=20

# Embeddings (Document Chunks -> Embeddings milestone)
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM generation (RAG Foundation milestone) — shares OPENAI_API_KEY above
LLM_MODEL=gpt-5.4-mini
